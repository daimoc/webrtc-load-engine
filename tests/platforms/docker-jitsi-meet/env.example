# Copy to .env (not committed) with ./setup.sh, which also fills the
# passwords. Variables left commented out keep the images' defaults.

# Configuration and storage of the containers, regenerated at each start.
CONFIG=~/.jitsi-meet-cfg

HTTP_PORT=8000
HTTPS_PORT=8443
TZ=UTC

# Internal XMPP accounts of the focus and the bridge (openssl rand -hex 16).
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

# Bridge heap. The image default (3072m) fills up at 100 simulcast bots
# (006 validation report), so the runs use 8 GB.
VIDEOBRIDGE_MAX_MEMORY=8192m
#JICOFO_MAX_MEMORY=3072m

# Address the bridge announces in its ICE candidates; set the host's LAN
# address if the bots run on another machine.
#JVB_ADVERTISE_IPS=192.168.1.10

# Token authentication (003 T058), for runs with --jwt-app-id and
# JITSI_APP_SECRET. Leave commented out for anonymous rooms.
#ENABLE_AUTH=1
#AUTH_TYPE=jwt
#JWT_APP_ID=my_app
#JWT_APP_SECRET=
#ENABLE_GUESTS=0
