# Copy to .env (not committed). See README.md.

# Janus log level, 0-7 (3: warnings and errors).
JANUS_DEBUG_LEVEL=3

# Janus never gathers ICE candidates on loopback: the bots reach it on the
# host's own IPv4 addresses (container bridges are ignored, see
# conf/janus.jcfg). Name one interface here to offer only its address, e.g.
# JANUS_ICE_ENFORCE_LIST=enp0s31f6 (see `ip -4 -br addr`).
JANUS_ICE_ENFORCE_LIST=
