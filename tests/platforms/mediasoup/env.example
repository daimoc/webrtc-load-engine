# Copy to .env (not committed).
# mediasoup workers (one media thread each). A room runs on one worker unless
# the test plan sets use_pipe_transports (then two).
MEDIASOUP_NUM_WORKERS=2
# Address announced in ICE candidates; set the host's LAN address if the bots
# run on another network namespace. Empty: 127.0.0.1.
MEDIASOUP_ANNOUNCED_ADDRESS=
# Receive and send buffer of the media sockets, in bytes (empty: the kernel
# default, 208 KiB). Every bot of a worker shares one UDP port: at 100 bots the
# default overflows. The kernel caps it at net.core.rmem_max / wmem_max.
MEDIASOUP_SOCKET_BUFFER=4194304
# Worker log level (warn, debug); debug also needs DEBUG="mediasoup*".
# MEDIASOUP_LOG_LEVEL=warn
# Leave UNLIMITED_ROOM_SECRET unset: rooms then have no 10-minute limit.
# UNLIMITED_ROOM_SECRET=
# Optional TLS for the demo's web app (wss://); see README "See the room in a browser".
# MEDIASOUP_TLS_CERT=/certs/cert.pem
# MEDIASOUP_TLS_KEY=/certs/key.pem
